# ──────────────────────────────────────────────────────────────────────────────
# RENAME THIS FILE TO .env BEFORE RUNNING THE APPLICATION
# Never commit the .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Reddit ────────────────────────────────────────────────────────────────────
# Create an application at https://www.reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_USER_AGENT=AutoPostingBot/1.0
REDDIT_SUBREDDIT=test          # subreddit to post to (without r/)

# ── Telegram ──────────────────────────────────────────────────────────────────
# 1. Create a bot via @BotFather and copy the token.
# 2. Add the bot to your channel and get the chat_id (use @username for public channels).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=@your_channel_username   # e.g. @mychannel or a numeric id

# ── Dev.to ────────────────────────────────────────────────────────────────────
# Generate an API key at https://dev.to/settings/extensions
DEVTO_API_KEY=your_devto_api_key

# ── Hashnode ──────────────────────────────────────────────────────────────────
# Generate a Personal Access Token at https://hashnode.com/settings/developer
# Publication ID is found in your blog dashboard URL or settings.
HASHNODE_TOKEN=your_hashnode_personal_access_token
HASHNODE_PUBLICATION_ID=your_hashnode_publication_id

# ── Discord ───────────────────────────────────────────────────────────────────
# Create a webhook: Channel Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# ── LinkedIn ──────────────────────────────────────────────────────────────────
# OAuth 2.0 access token (w_member_social scope required).
# Person URN: the numeric ID after /in/ in your LinkedIn profile URL.
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_PERSON_URN=your_linkedin_person_id   # numeric only, e.g. 123456789

# ── Mastodon ──────────────────────────────────────────────────────────────────
# Generate a token at: Preferences > Development > New Application (write:statuses scope)
MASTODON_ACCESS_TOKEN=your_mastodon_access_token
MASTODON_INSTANCE_URL=https://mastodon.social

